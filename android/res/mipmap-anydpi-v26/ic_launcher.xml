<?xml version="1.0" encoding="utf-8"?>
<!-- Android 8+ shapes launcher icons itself (circle, squircle…). The flower is
     the page's maskable icon (public/icons/maskable-512.png, copied in by
     scripts/build-android.mjs), whose drawing sits inside the middle 43%,
     well within an adaptive icon's safe zone; the background is its colour. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/icon_background" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
</adaptive-icon>
