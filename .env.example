# Whisper model: tiny, base, small, medium, large-v3 — or `auto` (default),
# which sizes the model to your machine so it runs well anywhere: `small` on a
# CPU-only box (light, fast enough), and `large-v3` when a capable GPU is present
# (best accuracy, kept fast by the GPU), stepping down on smaller cards. Set a
# concrete name to force one. Note: base/tiny hallucinate badly on Chinese.
WHISPER_MODEL=auto

# Device for the offline NLLB translator: cpu (default) or cuda. It stays on the
# CPU by default so the GPU is free for transcription, which is the heavier job;
# the resident translator would otherwise hog ~4 GB and push Whisper onto the CPU.
# Translating subtitle lines on CPU only costs seconds. Set =cuda only if you
# have plenty of spare VRAM for both models at once.
# TRANSLATE_DEVICE=cuda

# Force a transcription device if auto-detection misbehaves: cpu or cuda.
# WHISPER_DEVICE=cuda

# Word-lookup explanations AND subtitle/screenshot translation use any
# OpenAI-compatible chat API.
# Pick ONE provider and set the three LLM_* vars. If none are set, the app
# falls back to the local NLLB translator (meanings only, no real explanations).
#
# Why it matters for translation: the offline model transliterates names
# syllable by syllable — 黑尔戈兰级 came out as "Herle Golan class" rather than
# Helgoland, and 日德兰海战 as "the battle in the Sea of Japan" rather than
# Jutland. A chat model knows the names and can see the neighbouring lines.
# Anything over 400 lines still goes to the offline model, which is faster in
# bulk and free. Set LLM_TRANSLATE=off to always use the offline model.
# LLM_TRANSLATE=off
#
# Free hosted (Groq) — get a key at https://console.groq.com/keys :
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=llama-3.3-70b-versatile
# LLM_API_KEY=gsk_your_key_here
#
# Free + offline (local Ollama — `ollama pull qwen2.5:3b`):
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=qwen2.5:3b
# LLM_API_KEY=ollama
#
# OpenAI (paid): just set OPENAI_API_KEY and leave the LLM_* vars unset.
# OPENAI_API_KEY=sk-...

# Listening: three engines, best first. piper — a small neural synthesiser that
# actually sounds like a person — when a voice for the language is installed,
# then the browser's own speechSynthesis, then espeak-ng, which is robotic but
# always there. On Linux the browser's voices are usually espeak-ng anyway
# (speech-dispatcher), so piper is preferred over them rather than under them.
#
# Voices are opt-in: `VOICES=1 npm run sync` fetches piper voices for Chinese
# and English (~63 MB each) into ~/.local/share/stele/voices, and installs
# piper itself. Without them the listen button still works, using espeak-ng,
# which is robotic. To add another
# language, drop its .onnx and .onnx.json in that folder, named by language the
# way piper names them (ja_JP-…): the app picks it up without a restart.
# Voices: https://huggingface.co/rhasspy/piper-voices
# STELE_VOICE_DIR=/somewhere/else
#
# Chinese subtitles are normalised to Traditional characters (OpenCC s2tw) by
# default. Set to "off" to keep each source's original script.
# ZH_SCRIPT=off

# Imported videos are kept so a card's "jump back" control can reload the video
# and return to the moment it was made from. They live in
# ~/.local/share/stele/videos — beside the backups and the piper voices, and
# outside the checkout for the same reason: they are the largest files this app
# produces and have no business inside a git working tree. Point this anywhere,
# an external drive included; the disk is yours, not the app's.
# STELE_VIDEO_DIR=/somewhere/with/room
#
# That folder is pruned, because nothing about its growth is visible until
# something else breaks. Two limits, and either takes 0 to switch it off.
# What 20 costs depends entirely on what you import: a 93-second news clip is
# ~6 MB, so twenty of those is around 120 MB — but a 40-minute talk is nearer
# 150 MB on its own, and twenty of those is 3 GB. Raise it if you are building
# a library you mean to keep, lower it if the disk is tight.
# VIDEO_CACHE_MAX=20           # keep the newest N videos; 0 keeps every one
# VIDEO_CACHE_MAX_AGE_DAYS=30  # drop anything older; 0 never expires by age
#
# Re-importing a URL you already have re-uses the stored file instead of
# downloading it again. The limit below is separate from the two above: those
# decide what is worth keeping, this decides how long a stored file is still
# trusted to be what the link serves *now* — a re-upload, or a better format
# appearing, is invisible to a hit. Past it the video is fetched again.
# VIDEO_CACHE_HIT_MAX_AGE_DAYS=7  # re-use a stored video for N days; 0 = forever
